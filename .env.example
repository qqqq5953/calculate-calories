# ── LINE Messaging API（LINE Developers → 你的 Messaging API channel）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── LINE Login channel（LIFF app 所在的 channel；用來驗證儀表板登入的 ID token）
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=

# ── 資料庫（Supabase → Project Settings → Database → Connection string）
# 正式環境建議用 Transaction pooler（port 6543）
# 本機：supabase start 印出的 DB URL，通常是 postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# ── 照片儲存（可省略：沒設定就不存照片，記錄照常運作）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=meal-photos

# ── Anthropic API（console.anthropic.com 申請）
ANTHROPIC_API_KEY=
# 預設 claude-haiku-5-5；辨識不夠準可以改成 claude-sonnet-5-5
AI_MODEL=claude-haiku-5-5

# ── 儀表板登入 session 的簽章金鑰（隨機長字串，例如 openssl rand -hex 32）
SESSION_SECRET=

# ── Vercel Cron 驗證用（Vercel 會自動帶 Authorization: Bearer $CRON_SECRET）
CRON_SECRET=

# ── 管理者的 LINE userId（DB 連不上時通知；可省略）
ADMIN_LINE_USER_ID=
